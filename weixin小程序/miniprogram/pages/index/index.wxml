<scroll-view class="capsule-page" scroll-y="true" wx:if="{{!loading}}">

  <!-- ========== 顶部 ========== -->
  <view class="capsule-header">
    <view class="date-badge">
      <text class="date-icon">⏳</text>
      <text class="date-text">{{todayDate}}</text>
    </view>
    <view class="title-row">
      <text class="capsule-title">🕰️ 时间胶囊</text>
      <text class="sync-hint">同步于 {{syncTime}}</text>
    </view>
  </view>

  <!-- ========== 今日战报（柔和暖色） ========== -->
  <view class="battle-card status-{{trainLevel}}">
    <view class="battle-glow"></view>
    <view class="battle-header">
      <text class="battle-star">✦</text>
      <text class="battle-label">今日专注力冒险战报</text>
    </view>
    <text class="battle-title">{{trainLevelText}}</text>
    <text class="battle-desc">{{progressText}}</text>

    <!-- 分段进度轨道 -->
    <view class="railway">
      <view class="rail-track">
        <view class="rail-ticks">
          <view class="rail-tick" style="left:30%;"></view>
          <view class="rail-tick" style="left:70%;"></view>
        </view>
        <view class="rail-fill {{todayFocus < 30 ? 'zone-yellow' : todayFocus < 70 ? 'zone-green' : 'zone-blue'}}" style="width: {{todayFocus}}%;"></view>
      </view>
      <view class="train-marker" style="left: {{todayFocus}}%;">
        <text class="train-emoji">🚂</text>
        <view class="train-bubble">{{todayFocus}}分</view>
      </view>
    </view>
    <view class="rail-labels">
      <text>起步</text><text>30 推进</text><text>70 优秀</text>
    </view>
  </view>

  <!-- ========== 当前游戏进度 ========== -->
  <view class="game-card">
    <view class="game-header">
      <text class="game-icon">{{gameIcon}}</text>
      <view class="game-info">
        <text class="game-label">正在挑战</text>
        <text class="game-name">{{currentGame}}</text>
      </view>
      <view class="game-badge">{{gameCount}}局</view>
    </view>

    <!-- 关卡进度（0%浅橙 / 0-30%浅黄 / 30%+绿） -->
    <view class="level-rows">
      <view class="level-row">
        <view class="level-icon-wrap camp-bg">🥕</view>
        <view class="level-info">
          <text class="level-name">食材准备营</text>
          <view class="level-bar-wrap">
            <view class="level-bar {{levelProgress.camp == 0 ? 'lvl-orange' : levelProgress.camp < 30 ? 'lvl-yellow' : 'lvl-green'}}" style="width: {{levelProgress.camp == 0 ? 6 : levelProgress.camp}}%;"></view>
          </view>
        </view>
        <text class="level-pct {{levelProgress.camp == 0 ? 'pct-gray' : levelProgress.camp < 30 ? 'pct-yellow' : 'pct-green'}}">{{levelProgress.camp}}%</text>
      </view>
      <view class="level-row">
        <view class="level-icon-wrap room-bg">🥩</view>
        <view class="level-info">
          <text class="level-name">失重备菜室</text>
          <view class="level-bar-wrap">
            <view class="level-bar {{levelProgress.room == 0 ? 'lvl-orange' : levelProgress.room < 30 ? 'lvl-yellow' : 'lvl-green'}}" style="width: {{levelProgress.room == 0 ? 6 : levelProgress.room}}%;"></view>
          </view>
        </view>
        <text class="level-pct {{levelProgress.room == 0 ? 'pct-gray' : levelProgress.room < 30 ? 'pct-yellow' : 'pct-green'}}">{{levelProgress.room}}%</text>
      </view>
      <view class="level-row">
        <view class="level-icon-wrap kitchen-bg">🍳</view>
        <view class="level-info">
          <text class="level-name">林间小厨房</text>
          <view class="level-bar-wrap">
            <view class="level-bar {{levelProgress.kitchen == 0 ? 'lvl-orange' : levelProgress.kitchen < 30 ? 'lvl-yellow' : 'lvl-green'}}" style="width: {{levelProgress.kitchen == 0 ? 6 : levelProgress.kitchen}}%;"></view>
          </view>
        </view>
        <text class="level-pct {{levelProgress.kitchen == 0 ? 'pct-gray' : levelProgress.kitchen < 30 ? 'pct-yellow' : 'pct-green'}}">{{levelProgress.kitchen}}%</text>
      </view>
    </view>
  </view>

  <!-- ========== 今日数据小结（彩色底卡片） ========== -->
  <view class="stats-row">
    <view class="stat-box sb-duration">
      <text class="stat-icon">⏱️</text>
      <text class="stat-num">{{todayDurationDisplay}}<text class="stat-unit"> 分钟</text></text>
    </view>
    <view class="stat-box sb-peak">
      <text class="stat-icon">⚡</text>
      <text class="stat-num {{todayPeak < 50 ? 'num-yellow' : 'num-green'}}">{{todayPeak}}<text class="stat-unit"> 峰值分</text></text>
    </view>
    <view class="stat-box sb-distract">
      <text class="stat-icon">🛡️</text>
      <text class="stat-num {{todayDistract > 5 ? 'num-orange' : 'num-green'}}">{{todayDistract}}<text class="stat-unit"> 次走神</text></text>
    </view>
  </view>

</scroll-view>

<!-- 加载态 -->
<view class="loading-shell" wx:else>
  <view class="capsule-loader"></view>
  <text class="loading-text">时间胶囊开启中...</text>
</view>
